# ──────────────────────────────────────────────────────────────────────────
# RedLine environment - copy to `.env` and fill in. NEVER commit a real .env.
# Every key below is OPTIONAL for `npm run typecheck && test && eval`, which run
# green with zero secrets via the local fallbacks. Keys enable LIVE data/judging.
# ──────────────────────────────────────────────────────────────────────────

# Database (matches docker-compose.yml; `npm run db:up` starts it)
DATABASE_URL=postgres://redline:redline@localhost:5433/redline

# ── LLM (Stage B rubric judge + memo generation) ───────────────────────────
# 'local'    = deterministic rubric-aligned judge, no key, hermetic (DEFAULT)
# 'anthropic'= Claude via API (best quality) - needs ANTHROPIC_API_KEY
# 'ollama'   = local Llama/etc via Ollama server - needs OLLAMA_BASE_URL
LLM_PROVIDER=local
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OLLAMA_BASE_URL=http://localhost:11434

# ── Embeddings (Stage A pgvector prefilter) ────────────────────────────────
# 'hash'  = deterministic in-process embedder, no deps, hermetic (DEFAULT)
# 'local' = transformers.js bge-small-en (optional dep, downloads weights once)
# 'ollama'= nomic-embed-text via Ollama
# 'api'   = OpenAI-compatible embeddings endpoint
# EMBED_DIM MUST match the embedder: hash/bge-small=384 | nomic=768 | openai-3-small=1536
EMBEDDER=hash
EMBED_DIM=384
EMBED_API_URL=
EMBED_API_KEY=
EMBED_API_MODEL=text-embedding-3-small

# ── Data sources (free keys; ingestion only - pipeline/evals don't need them) ──
CONGRESS_API_KEY=            # api.data.gov (free)
REGULATIONS_API_KEY=         # api.data.gov (free)
OPENSTATES_API_KEY=          # open.pluralpolicy.com (free)
# Federal Register API needs NO key.

# ── Delivery ───────────────────────────────────────────────────────────────
SMTP_URL=                    # e.g. smtp://user:pass@host:587 ; empty = log-only Mailer
MAIL_FROM=redline@example.com

# ── Auth (Auth.js) - stubbed in v1 ─────────────────────────────────────────
AUTH_SECRET=

# ── Pipeline tuning ─────────────────────────────────────────────────────────
MEMO_THRESHOLD=4             # score >= this drafts a memo
PREFILTER_LIMIT=50           # Stage A candidate cap
